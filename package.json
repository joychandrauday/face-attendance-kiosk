{
  "name": "@karalasoft/face-attendance-kiosk",
  "version": "1.3.2",
  "type": "module",
  "description": "Enterprise React / Next.js Biometric Face Attendance, Multi-Angle Enrollment & Analytics SDK for SureClock",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "nextjs",
    "face-attendance",
    "kiosk",
    "biometric",
    "face-recognition",
    "multi-angle",
    "karalasoft",
    "sureclock"
  ],
  "author": "KaralaSoft Team",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
